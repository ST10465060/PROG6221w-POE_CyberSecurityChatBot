<Window x:Class="CyberSecurityChatBotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" Height="700" Width="550"
        Background="#1a1a2e" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock x:Name="AsciiArtDisplay"
                       FontFamily="Consolas" FontSize="8"
                       Foreground="#00d4ff" TextAlignment="Center"
                       Text="[ ASCII ART LOADS HERE ]"/>
            <TextBlock Text="Cybersecurity Awareness Bot"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#e0e0e0" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Row 1: Quick action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button Content="📋 Tasks" Padding="10,5" Margin="3"
                    Background="#0f3460" Foreground="White" FontSize="12"
                    Click="TasksButton_Click"/>
            <Button Content="🎮 Quiz" Padding="10,5" Margin="3"
                    Background="#0f3460" Foreground="White" FontSize="12"
                    Click="QuizButton_Click"/>
            <Button Content="📝 Log" Padding="10,5" Margin="3"
                    Background="#0f3460" Foreground="White" FontSize="12"
                    Click="LogButton_Click"/>
            <Button Content="❓ Help" Padding="10,5" Margin="3"
                    Background="#0f3460" Foreground="White" FontSize="12"
                    Click="HelpButton_Click"/>
        </StackPanel>

        <!-- Row 2: Chat display -->
        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="2" Margin="10"
                      VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="ChatDisplay"
                       TextWrapping="Wrap" Foreground="#e0e0e0"
                       FontSize="14" FontFamily="Segoe UI"/>
        </ScrollViewer>

        <!-- Row 3: Input area -->
        <Grid Grid.Row="3" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UserInputBox" Grid.Column="0"
                     FontSize="14" Padding="8" Margin="0,0,5,0"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#0f3460"
                     KeyDown="UserInputBox_KeyDown"/>

            <Button x:Name="SendButton" Grid.Column="1"
                    Content="Send" Padding="15,8"
                    FontSize="14" FontWeight="Bold"
                    Background="#0f3460" Foreground="White"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
